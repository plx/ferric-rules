# Exclude CLIPS test fixtures from GitHub language statistics.
# See: https://github.com/github-linguist/linguist/blob/main/docs/overrides.md
*.clp linguist-vendored
*.bat linguist-vendored
*.tst linguist-vendored

# Keep checked-in text shipped by the Node package byte-identical on Windows.
packages/ferric/package.json text eol=lf
packages/ferric/README.md text eol=lf
packages/ferric/native/index.js text eol=lf
packages/ferric/native/runtime-target.js text eol=lf
packages/ferric/native/targets.json text eol=lf

# Keep Python package metadata and files embedded in distributions stable.
LICENSE-MIT text eol=lf
LICENSE-APACHE text eol=lf
crates/ferric-rules-python/README.md text eol=lf
crates/ferric-rules-python/LICENSE-MIT text eol=lf
crates/ferric-rules-python/LICENSE-APACHE text eol=lf
crates/ferric-rules-python/wheel-targets.json text eol=lf
docs/python-package-release.md text eol=lf
scripts/musl_static_libgcc_linker.py text eol=lf

# Keep native Rust target provenance byte-identical on Windows.
crates/ferric-rules-cli/release-targets.json text eol=lf

# Exact compatibility oracles must be byte-identical on every native runner.
tests/clips_compat/corpus/** text eol=lf
# These oracles contain literal CR bytes (CLIPS stdin framing, scanner input
# and %r output); keep them byte-exact rather than line-ending normalized.
tests/clips_compat/corpus/io/read-crlf-readline-state.in -text
tests/clips_compat/corpus/patterns/116_source_scanner_cr_comments.clp -text
tests/clips_compat/corpus/stdlib/084_string_to_field_whitespace_comments_and_empty.clp -text
tests/clips_compat/corpus/stdlib/091_string_to_field_ascii_whitespace_controls.clp -text
tests/clips_compat/corpus/stdlib/092_string_to_field_control_whitespace_edges.clp -text
tests/clips_compat/corpus/stdlib/094_explode_ordinary_and_empty_fields.clp -text
tests/clips_compat/corpus/stdlib/108_format_ordinary_directives.out -text
tests/clips_compat/corpus/stdlib/136_implode_literal_control_characters.clp -text
tests/clips_compat/corpus/stdlib/136_implode_literal_control_characters.out -text
tests/clips_compat/corpus/stdlib/137_implode_literal_crlf_preservation.clp -text
tests/clips_compat/corpus/stdlib/137_implode_literal_crlf_preservation.out -text
tests/clips_compat/corpus/stdlib/180_printout_multifield_literal_control_bytes.clp -text
tests/clips_compat/corpus/stdlib/180_printout_multifield_literal_control_bytes.out -text
