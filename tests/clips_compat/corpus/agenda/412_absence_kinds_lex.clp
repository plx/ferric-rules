(deffacts seed (old) (u 1) (b 2))
(defrule a-pos (declare (salience 60)) (b ?) => (printout t A-POS crlf))
(defrule a-exists (declare (salience 60)) (u ?) (exists (b ?)) => (printout t A-EXISTS crlf))
(defrule a-forall (declare (salience 60)) (u ?) (forall (b ?x) (b ?x)) => (printout t A-FORALL crlf))
(defrule b-pos (declare (salience 50)) (u ?) => (printout t B-POS crlf))
(defrule b-exists (declare (salience 50)) (exists (b ?)) (u ?) => (printout t B-EXISTS crlf))
(defrule b-forall (declare (salience 50)) (forall (b ?x) (b ?x)) (u ?) => (printout t B-FORALL crlf))
(defrule c-exists (declare (salience 40)) (exists (b ?)) (u ?) => (printout t C-EXISTS crlf))
(defrule c-fact (declare (salience 40)) (old) (u ?) => (printout t C-FACT crlf))
(defrule d-test (declare (salience 30)) (test (> 1 0)) (u ?x) => (printout t D-TEST crlf))
(defrule d-not (declare (salience 30)) (not (zz)) (u ?x) => (printout t D-NOT crlf))
(defrule e-empty (declare (salience 20)) => (printout t E-EMPTY crlf))
(defrule e-not (declare (salience 20)) (not (zz)) => (printout t E-NOT crlf))
