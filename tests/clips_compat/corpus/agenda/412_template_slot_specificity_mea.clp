(deftemplate tt (slot a) (multislot b))
(deffacts seed (u 3) (b 2) (tt (a 1) (b 2 3)))
(defrule g1-a (declare (salience 50)) (u ?x) (not (and (absent) (missing))) (test (> ?x 0)) => (printout t G1-A crlf))
(defrule g1-b (declare (salience 50)) (u ?x) (not (and (absent) (missing))) (not (zz)) => (printout t G1-B crlf))
(defrule g2-old (declare (salience 40)) (tt (a ?) (b $?)) => (printout t G2-OLD crlf))
(defrule g3-forall (declare (salience 30)) (forall (u ?x) (u ?x)) (b ?) => (printout t G3-FORALL crlf))
(defrule g4-exists (declare (salience 20)) (exists (u ?) (b ?)) (tt) => (printout t G4-EXISTS crlf))
(defrule install (declare (salience 1000)) =>
  (build "(defrule g2-a1 (declare (salience 40)) (tt (a 1)) => (printout t G2-A1 crlf))")
  (build "(defrule g2-b23 (declare (salience 40)) (tt (b 2 3)) => (printout t G2-B23 crlf))")
  (build "(defrule g3-not4 (declare (salience 30)) (not (zz 1 2)) (b ?) => (printout t G3-NOT4 crlf))")
  (build "(defrule g3-not5 (declare (salience 30)) (not (zz 1 2 3)) (b ?) => (printout t G3-NOT5 crlf))")
  (build "(defrule g4-not3 (declare (salience 20)) (not (zz 1)) (tt) => (printout t G4-NOT3 crlf))")
  (build "(defrule g4-not4 (declare (salience 20)) (not (zz 1 2)) (tt) => (printout t G4-NOT4 crlf))"))
