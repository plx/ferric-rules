(defglobal ?*trace* = 0)
(deffunction mark (?digit ?value) (bind ?*trace* (+ (* ?*trace* 10) ?digit)) ?value)
(defrule probe =>
  (bind ?*trace* 0)
  (printout t "=:" (= (mark 1 1) (mark 2 2) (mark 3 2)) ":" ?*trace* crlf)
  (bind ?*trace* 0)
  (printout t "<>:" (<> (mark 1 1) (mark 2 1) (mark 3 2)) ":" ?*trace* crlf)
  (bind ?*trace* 0)
  (printout t "<:" (< (mark 1 2) (mark 2 1) (mark 3 3)) ":" ?*trace* crlf)
  (bind ?*trace* 0)
  (printout t ">:" (> (mark 1 1) (mark 2 2) (mark 3 0)) ":" ?*trace* crlf)
  (bind ?*trace* 0)
  (printout t "<=:" (<= (mark 1 2) (mark 2 1) (mark 3 3)) ":" ?*trace* crlf)
  (bind ?*trace* 0)
  (printout t ">=:" (>= (mark 1 1) (mark 2 2) (mark 3 0)) ":" ?*trace* crlf))