(deftemplate z (slot x))
(deftemplate a (slot x))
(deftemplate z (slot y))
(deffacts seed (seeded 1))
(deffunction dormant () (assert (nested 1)))
(defrule first (never) =>)
(defrule second (never) =>)
(defrule first (never) =>)
(defrule report =>
  (printout t (get-deftemplate-list) crlf (get-defrule-list) crlf)
  (retract 1)
  (printout t (deftemplate-slot-names seeded) "|" (get-deftemplate-list) crlf)
  (if (member$ second (get-defrule-list)) then (undefrule second))
  (printout t (get-defrule-list) crlf))
