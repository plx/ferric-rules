;; #340 pinned CLIPS characterization: integer-precision

(deffacts startup (go))
(defrule exercise (go) =>
(printout t "[" (format nil "%.3d" 7) "]" crlf)
(printout t "[" (format nil "%.3d" -7) "]" crlf)
(printout t "[" (format nil "%.3d" 0) "]" crlf)
(printout t "[" (format nil "%08.3d" 7) "]" crlf)
(printout t "[" (format nil "%08.3d" -7) "]" crlf)
(printout t "[" (format nil "%08.3d" 0) "]" crlf)
(printout t "[" (format nil "%8.3d" 7) "]" crlf)
(printout t "[" (format nil "%8.3d" -7) "]" crlf)
(printout t "[" (format nil "%8.3d" 0) "]" crlf)
(printout t "[" (format nil "%-08.3d" 7) "]" crlf)
(printout t "[" (format nil "%-08.3d" -7) "]" crlf)
(printout t "[" (format nil "%-08.3d" 0) "]" crlf)
(printout t "[" (format nil "%.0d" 7) "]" crlf)
(printout t "[" (format nil "%.0d" -7) "]" crlf)
(printout t "[" (format nil "%.0d" 0) "]" crlf)
(printout t "[" (format nil "%05.0d" 7) "]" crlf)
(printout t "[" (format nil "%05.0d" -7) "]" crlf)
(printout t "[" (format nil "%05.0d" 0) "]" crlf)
(printout t "[" (format nil "%.d" 7) "]" crlf)
(printout t "[" (format nil "%.d" -7) "]" crlf)
(printout t "[" (format nil "%.d" 0) "]" crlf)
)
