(defrule probe =>
  (printout t (= 0.0 1e-20) ":" (<> 0.0 1e-20) ":" (= -0.0 0.0) crlf)
  (printout t (= 9007199254740992 9007199254740993) ":"
              (< 9007199254740992 9007199254740993) ":"
              (> 9007199254740993 9007199254740992) crlf)
  (printout t (<= 9007199254740993 9007199254740992) ":"
              (>= 9007199254740992 9007199254740993) crlf))