;; A single-field multislot join key is a multifield, not a raw scalar,
;; across both arrival directions of an indexed join.
(deftemplate item (multislot value) (slot side))
(defglobal ?*left* = 0 ?*right* = 0)
(deffacts input
  (key-before k0)
  (key-before k1)
  (key-before k2)
  (key-before k3)
  (key-before k4)
  (key-before k5)
  (key-before k6)
  (key-before k7)
  (key-before k8)
  (key-before k9)
  (key-before k10)
  (key-before k11)
  (key-before k12)
  (key-before k13)
  (key-before k14)
  (key-before k15)
  (key-before k16)
  (key-before k17)
  (key-before k18)
  (key-before k19)
  (key-before k20)
  (key-before k21)
  (key-before k22)
  (key-before k23)
  (item (value k0) (side right))
  (item (value k1) (side right))
  (item (value k2) (side right))
  (item (value k3) (side right))
  (item (value k4) (side right))
  (item (value k5) (side right))
  (item (value k6) (side right))
  (item (value k7) (side right))
  (item (value k8) (side right))
  (item (value k9) (side right))
  (item (value k10) (side right))
  (item (value k11) (side right))
  (item (value k12) (side right))
  (item (value k13) (side right))
  (item (value k14) (side right))
  (item (value k15) (side right))
  (item (value k16) (side right))
  (item (value k17) (side right))
  (item (value k18) (side right))
  (item (value k19) (side right))
  (item (value k20) (side right))
  (item (value k21) (side right))
  (item (value k22) (side right))
  (item (value k23) (side right))
  (item (value k0) (side left))
  (item (value k1) (side left))
  (item (value k2) (side left))
  (item (value k3) (side left))
  (item (value k4) (side left))
  (item (value k5) (side left))
  (item (value k6) (side left))
  (item (value k7) (side left))
  (item (value k8) (side left))
  (item (value k9) (side left))
  (item (value k10) (side left))
  (item (value k11) (side left))
  (item (value k12) (side left))
  (item (value k13) (side left))
  (item (value k14) (side left))
  (item (value k15) (side left))
  (item (value k16) (side left))
  (item (value k17) (side left))
  (item (value k18) (side left))
  (item (value k19) (side left))
  (item (value k20) (side left))
  (item (value k21) (side left))
  (item (value k22) (side left))
  (item (value k23) (side left))
  (key-after k0)
  (key-after k1)
  (key-after k2)
  (key-after k3)
  (key-after k4)
  (key-after k5)
  (key-after k6)
  (key-after k7)
  (key-after k8)
  (key-after k9)
  (key-after k10)
  (key-after k11)
  (key-after k12)
  (key-after k13)
  (key-after k14)
  (key-after k15)
  (key-after k16)
  (key-after k17)
  (key-after k18)
  (key-after k19)
  (key-after k20)
  (key-after k21)
  (key-after k22)
  (key-after k23)
)
(defrule right-arrival
  (key-before ?key) (item (value ?key) (side right))
  => (bind ?*right* (+ ?*right* 1)))
(defrule left-arrival
  (key-after ?key) (item (value ?key) (side left))
  => (bind ?*left* (+ ?*left* 1)))
(defrule summary (declare (salience -10))
  => (printout t ?*left* ":" ?*right* crlf))
