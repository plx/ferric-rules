(deffacts d (phase keys-first))
(defrule seed (declare (salience 100)) (phase keys-first)
 => (assert (first a) (second b) (lst a a b b)))
(defrule observe (phase ?phase) (first ?a) (second ?b) (lst $?pre ?a $?mid ?b $?post)
 => (printout t ?phase ":" (length$ ?pre) ":" (length$ ?mid) ":" (length$ ?post) crlf))
(defrule next (declare (salience -10)) ?phase <- (phase keys-first)
 ?a <- (first ?) ?b <- (second ?) ?list <- (lst $?)
 => (retract ?phase ?a ?b ?list)
 (assert (phase list-first) (lst a a b b) (first a) (second b)))
(defrule done (declare (salience -20)) (phase list-first) => (printout t done crlf))
