;; More than sixteen candidates cover dynamic-position joins and indexed descendants.
(defglobal ?*left-arrival* = 0 ?*right-arrival* = 0 ?*indexed-left* = 0 ?*indexed-right* = 0)
(deffacts input
  (key-before k0)
  (key-before k1)
  (key-before k2)
  (key-before k3)
  (key-before k4)
  (key-before k5)
  (key-before k6)
  (key-before k7)
  (key-before k8)
  (key-before k9)
  (key-before k10)
  (key-before k11)
  (key-before k12)
  (key-before k13)
  (key-before k14)
  (key-before k15)
  (key-before k16)
  (key-before k17)
  (key-before k18)
  (key-before k19)
  (key-before k20)
  (key-before k21)
  (key-before k22)
  (key-before k23)
  (row-before payload k0 tail)
  (row-before payload k1 tail)
  (row-before payload k2 tail)
  (row-before payload k3 tail)
  (row-before payload k4 tail)
  (row-before payload k5 tail)
  (row-before payload k6 tail)
  (row-before payload k7 tail)
  (row-before payload k8 tail)
  (row-before payload k9 tail)
  (row-before payload k10 tail)
  (row-before payload k11 tail)
  (row-before payload k12 tail)
  (row-before payload k13 tail)
  (row-before payload k14 tail)
  (row-before payload k15 tail)
  (row-before payload k16 tail)
  (row-before payload k17 tail)
  (row-before payload k18 tail)
  (row-before payload k19 tail)
  (row-before payload k20 tail)
  (row-before payload k21 tail)
  (row-before payload k22 tail)
  (row-before payload k23 tail)
  (row-after payload k0 tail)
  (row-after payload k1 tail)
  (row-after payload k2 tail)
  (row-after payload k3 tail)
  (row-after payload k4 tail)
  (row-after payload k5 tail)
  (row-after payload k6 tail)
  (row-after payload k7 tail)
  (row-after payload k8 tail)
  (row-after payload k9 tail)
  (row-after payload k10 tail)
  (row-after payload k11 tail)
  (row-after payload k12 tail)
  (row-after payload k13 tail)
  (row-after payload k14 tail)
  (row-after payload k15 tail)
  (row-after payload k16 tail)
  (row-after payload k17 tail)
  (row-after payload k18 tail)
  (row-after payload k19 tail)
  (row-after payload k20 tail)
  (row-after payload k21 tail)
  (row-after payload k22 tail)
  (row-after payload k23 tail)
  (key-after k0)
  (key-after k1)
  (key-after k2)
  (key-after k3)
  (key-after k4)
  (key-after k5)
  (key-after k6)
  (key-after k7)
  (key-after k8)
  (key-after k9)
  (key-after k10)
  (key-after k11)
  (key-after k12)
  (key-after k13)
  (key-after k14)
  (key-after k15)
  (key-after k16)
  (key-after k17)
  (key-after k18)
  (key-after k19)
  (key-after k20)
  (key-after k21)
  (key-after k22)
  (key-after k23)
)
(defrule right-arrival
  (key-before ?key)
  (row-after $?prefix ?key tail)
  (test (= (length$ ?prefix) 1))
  => (bind ?*right-arrival* (+ ?*right-arrival* 1)))
(defrule left-arrival
  (key-after ?key)
  (row-before $?prefix ?key tail)
  (test (= (length$ ?prefix) 1))
  => (bind ?*left-arrival* (+ ?*left-arrival* 1)))
;; A capture-bearing parent feeds an ordinary indexed scalar equality join.
(defrule indexed-left-arrival
  (row-after $?prefix ?key tail)
  (key-before ?key)
  (test (= (length$ ?prefix) 1))
  => (bind ?*indexed-left* (+ ?*indexed-left* 1)))
(defrule indexed-right-arrival
  (row-before $?prefix ?key tail)
  (key-after ?key)
  (test (= (length$ ?prefix) 1))
  => (bind ?*indexed-right* (+ ?*indexed-right* 1)))
(defrule summary
  (declare (salience -10))
  => (printout t ?*left-arrival* ":" ?*right-arrival* ":" ?*indexed-left* ":" ?*indexed-right* crlf))
