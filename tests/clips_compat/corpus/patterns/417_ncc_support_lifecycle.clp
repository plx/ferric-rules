(deffacts d (first a) (second b) (phase zero))
(defrule observe (first ?a) (second ?b)
 (not (and (lst $? ?a $? ?b $?) (marker))) (phase ?phase)
 => (printout t "ncc:" ?phase crlf))
(defrule start (declare (salience -10)) ?phase <- (phase zero)
 => (retract ?phase) (assert (lst a b) (lst a middle b) (lst b a) (marker) (phase two)))
(defrule remove-one (declare (salience -10)) ?phase <- (phase two) ?row <- (lst a b)
 => (retract ?phase ?row) (assert (phase one)))
(defrule remove-marker (declare (salience -10)) ?phase <- (phase one) ?marker <- (marker)
 => (retract ?phase ?marker) (assert (phase unblocked)))
(defrule reintroduce (declare (salience -10)) ?phase <- (phase unblocked)
 => (retract ?phase) (assert (marker) (phase again)))
(defrule remove-last (declare (salience -10)) ?phase <- (phase again) ?row <- (lst a middle b)
 => (retract ?phase ?row) (assert (phase final)))
(defrule done (declare (salience -20)) (phase final) => (printout t done crlf))
