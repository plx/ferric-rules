;; A join key follows the written slot name, not the physical slot order.
(deftemplate item (slot decoy) (slot key) (multislot tags) (slot side))
(defglobal ?*left* = 0 ?*right* = 0)
(deffacts input
  (key-before k0)
  (key-before k1)
  (key-before k2)
  (key-before k3)
  (key-before k4)
  (key-before k5)
  (key-before k6)
  (key-before k7)
  (key-before k8)
  (key-before k9)
  (key-before k10)
  (key-before k11)
  (key-before k12)
  (key-before k13)
  (key-before k14)
  (key-before k15)
  (key-before k16)
  (key-before k17)
  (key-before k18)
  (key-before k19)
  (key-before k20)
  (key-before k21)
  (key-before k22)
  (key-before k23)
  (item (decoy sentinel) (key k0) (tags x y) (side right))
  (item (decoy sentinel) (key k1) (tags x y) (side right))
  (item (decoy sentinel) (key k2) (tags x y) (side right))
  (item (decoy sentinel) (key k3) (tags x y) (side right))
  (item (decoy sentinel) (key k4) (tags x y) (side right))
  (item (decoy sentinel) (key k5) (tags x y) (side right))
  (item (decoy sentinel) (key k6) (tags x y) (side right))
  (item (decoy sentinel) (key k7) (tags x y) (side right))
  (item (decoy sentinel) (key k8) (tags x y) (side right))
  (item (decoy sentinel) (key k9) (tags x y) (side right))
  (item (decoy sentinel) (key k10) (tags x y) (side right))
  (item (decoy sentinel) (key k11) (tags x y) (side right))
  (item (decoy sentinel) (key k12) (tags x y) (side right))
  (item (decoy sentinel) (key k13) (tags x y) (side right))
  (item (decoy sentinel) (key k14) (tags x y) (side right))
  (item (decoy sentinel) (key k15) (tags x y) (side right))
  (item (decoy sentinel) (key k16) (tags x y) (side right))
  (item (decoy sentinel) (key k17) (tags x y) (side right))
  (item (decoy sentinel) (key k18) (tags x y) (side right))
  (item (decoy sentinel) (key k19) (tags x y) (side right))
  (item (decoy sentinel) (key k20) (tags x y) (side right))
  (item (decoy sentinel) (key k21) (tags x y) (side right))
  (item (decoy sentinel) (key k22) (tags x y) (side right))
  (item (decoy sentinel) (key k23) (tags x y) (side right))
  (item (decoy sentinel) (key k0) (tags x y) (side left))
  (item (decoy sentinel) (key k1) (tags x y) (side left))
  (item (decoy sentinel) (key k2) (tags x y) (side left))
  (item (decoy sentinel) (key k3) (tags x y) (side left))
  (item (decoy sentinel) (key k4) (tags x y) (side left))
  (item (decoy sentinel) (key k5) (tags x y) (side left))
  (item (decoy sentinel) (key k6) (tags x y) (side left))
  (item (decoy sentinel) (key k7) (tags x y) (side left))
  (item (decoy sentinel) (key k8) (tags x y) (side left))
  (item (decoy sentinel) (key k9) (tags x y) (side left))
  (item (decoy sentinel) (key k10) (tags x y) (side left))
  (item (decoy sentinel) (key k11) (tags x y) (side left))
  (item (decoy sentinel) (key k12) (tags x y) (side left))
  (item (decoy sentinel) (key k13) (tags x y) (side left))
  (item (decoy sentinel) (key k14) (tags x y) (side left))
  (item (decoy sentinel) (key k15) (tags x y) (side left))
  (item (decoy sentinel) (key k16) (tags x y) (side left))
  (item (decoy sentinel) (key k17) (tags x y) (side left))
  (item (decoy sentinel) (key k18) (tags x y) (side left))
  (item (decoy sentinel) (key k19) (tags x y) (side left))
  (item (decoy sentinel) (key k20) (tags x y) (side left))
  (item (decoy sentinel) (key k21) (tags x y) (side left))
  (item (decoy sentinel) (key k22) (tags x y) (side left))
  (item (decoy sentinel) (key k23) (tags x y) (side left))
  (key-after k0)
  (key-after k1)
  (key-after k2)
  (key-after k3)
  (key-after k4)
  (key-after k5)
  (key-after k6)
  (key-after k7)
  (key-after k8)
  (key-after k9)
  (key-after k10)
  (key-after k11)
  (key-after k12)
  (key-after k13)
  (key-after k14)
  (key-after k15)
  (key-after k16)
  (key-after k17)
  (key-after k18)
  (key-after k19)
  (key-after k20)
  (key-after k21)
  (key-after k22)
  (key-after k23)
)
(defrule right-arrival
  (key-before ?key) (item (key ?key) (tags $?tail) (decoy sentinel) (side right))
  => (bind ?*right* (+ ?*right* 1)))
(defrule left-arrival
  (key-after ?key) (item (key ?key) (tags $?tail) (decoy sentinel) (side left))
  => (bind ?*left* (+ ?*left* 1)))
(defrule summary (declare (salience -10))
  => (printout t ?*left* ":" ?*right* crlf))
