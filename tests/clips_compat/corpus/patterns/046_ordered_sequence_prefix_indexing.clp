(defrule right-tail-arrival
  (key-before ?key ?marker)
  (tail-after ?key $?tail)
  => (if (= (length$ ?tail) 0)
       then (bind ?*right-empty* (+ ?*right-empty* 1))
       else (bind ?*right-tail* (+ ?*right-tail* 1))))
(defrule right-split-arrival
  (key-before ?key ?marker)
  (split-after 900 ?key $?prefix ?marker $?suffix 999)
  => (bind ?*right-splits* (+ ?*right-splits* 1))
     (bind ?*right-prefix* (+ ?*right-prefix* (length$ ?prefix)))
     (bind ?*right-suffix* (+ ?*right-suffix* (length$ ?suffix))))
(defrule right-later-tests
  (key-before ?key ?marker)
  (split-after 900 ?key $?prefix ?marker $?suffix 999)
  (test (> (length$ ?prefix) 0))
  (test (= (length$ ?suffix) 1))
  => (bind ?*right-selected* (+ ?*right-selected* 1)))
(defrule left-tail-arrival
  (key-after ?key ?marker)
  (tail-before ?key $?tail)
  => (if (= (length$ ?tail) 0)
       then (bind ?*left-empty* (+ ?*left-empty* 1))
       else (bind ?*left-tail* (+ ?*left-tail* 1))))
(defrule left-split-arrival
  (key-after ?key ?marker)
  (split-before 900 ?key $?prefix ?marker $?suffix 999)
  => (bind ?*left-splits* (+ ?*left-splits* 1))
     (bind ?*left-prefix* (+ ?*left-prefix* (length$ ?prefix)))
     (bind ?*left-suffix* (+ ?*left-suffix* (length$ ?suffix))))
(defrule left-later-tests
  (key-after ?key ?marker)
  (split-before 900 ?key $?prefix ?marker $?suffix 999)
  (test (> (length$ ?prefix) 0))
  (test (= (length$ ?suffix) 1))
  => (bind ?*left-selected* (+ ?*left-selected* 1)))
(defrule summary (declare (salience -10)) =>
  (printout t "tails:" ?*right-empty* ":" ?*right-tail* ":" ?*left-empty* ":" ?*left-tail* crlf)
  (printout t "splits:" ?*right-splits* ":" ?*right-prefix* ":" ?*right-suffix* ":"
    ?*left-splits* ":" ?*left-prefix* ":" ?*left-suffix* crlf)
  (printout t "selected:" ?*right-selected* ":" ?*left-selected* crlf))
