(deffacts seed (p) (b))
(defrule not-test (declare (salience 40))
  (or (not (test (eq 1 1))) (not (test (eq 1 0))) (test (eq 1 1)))
  => (printout t not-test crlf))
(defrule exists-test (declare (salience 30))
  (or (exists (test (eq 1 0))) (exists (test (eq 1 1))) (test (eq 1 1)))
  => (printout t exists-test crlf))
(defrule and-test (declare (salience 20))
  (or (and (p) (not (test (eq 1 1))))
      (and (p) (not (test (eq 1 0))))
      (p))
  => (printout t and-test crlf))
(defrule split-conjunction (declare (salience 10))
  (or (not (or (a) (b))) (test (eq 1 1)))
  => (printout t split-conjunction crlf))
