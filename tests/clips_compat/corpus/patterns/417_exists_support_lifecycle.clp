(deffacts d (first a) (second b) (phase zero))
(defrule observe (first ?a) (second ?b) (exists (lst $? ?a $? ?b $?)) (phase ?phase)
 => (printout t "exists:" ?phase crlf))
(defrule start (declare (salience -10)) ?phase <- (phase zero)
 => (retract ?phase) (assert (lst a b) (lst a middle b) (lst b a) (phase two)))
(defrule remove-one (declare (salience -10)) ?phase <- (phase two) ?row <- (lst a b)
 => (retract ?phase ?row) (assert (phase one)))
(defrule remove-last (declare (salience -10)) ?phase <- (phase one) ?row <- (lst a middle b)
 => (retract ?phase ?row) (assert (phase none)))
(defrule reintroduce (declare (salience -10)) ?phase <- (phase none)
 => (retract ?phase) (assert (lst a b) (phase again)))
(defrule remove-and-rejoin (declare (salience -10)) ?phase <- (phase again) ?row <- (lst a b) ?key <- (first a)
 => (retract ?phase ?row ?key) (assert (phase final) (first a)))
(defrule done (declare (salience -20)) (phase final) => (printout t done crlf))
