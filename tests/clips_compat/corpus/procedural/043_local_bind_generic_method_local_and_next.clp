(defgeneric transform)
(defmethod transform ((?x NUMBER))
  (bind ?local (+ ?x 1))
  (bind ?x 88)
  ?local)
(defmethod transform ((?x INTEGER))
  (bind ?local (+ ?x 10))
  (bind ?x 99)
  (bind ?lower (call-next-method))
  (create$ ?local ?x ?lower))
(defrule probe => (printout t (transform 3) ":" (transform 5) crlf))
