(deffunction values ()
  (bind ?i 0)
  (printout t "while:" (while (< ?i 2) do (bind ?i (+ ?i 1)) 7) crlf)
  (printout t "while-empty:" (while FALSE do 7) crlf)
  (printout t "while-break:" (while TRUE do (break)) crlf)
  (printout t "count:" (loop-for-count (?n 1 2) do 7) crlf)
  (printout t "count-empty:" (loop-for-count (?n 2 1) do 7) crlf)
  (printout t "count-break:" (loop-for-count (?n 1 2) do (break)) crlf))
(defrule run => (values))
