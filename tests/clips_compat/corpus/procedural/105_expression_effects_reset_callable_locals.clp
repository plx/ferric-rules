(defglobal ?*g* = 1)
(deftemplate p (slot v))
(deffacts seed (p (v 1)))
(deffunction restart (?x)
  (bind ?local 8)
  (bind ?*g* 9)
  (printout t "before:" ?x ":" ?local ":" ?*g* crlf)
  (printout t "reset:[" (reset) "]" crlf)
  (printout t "after:" ?x ":" ?local ":" ?*g* crlf)
  (+ ?x ?local))
(defrule run ?f <- (p) =>
  (bind ?outer 3)
  (printout t "result:[" (restart 5) "] outer:" ?outer " old:" ?f ":" (fact-index ?f) crlf)
  (halt))
