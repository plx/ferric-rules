(defmodule MAIN (export ?ALL))
(deftemplate MAIN::p (slot x))
(deffacts MAIN::d (p (x 1)))
(defmodule A (import MAIN ?ALL) (export ?ALL))
(deffunction count-p () (length$ (find-all-facts ((?f (sym-cat p))) TRUE)))
(defmodule B (import A deffunction count-p))
(deftemplate B::p (slot x))
(deffacts B::d (p (x 2)) (p (x 3)))
(defrule B::query => (printout t (count-p) crlf))
(defrule MAIN::start => (focus B))
