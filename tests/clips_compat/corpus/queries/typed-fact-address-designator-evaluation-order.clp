(deftemplate item (slot v))
(deffacts seed (item (v 1)))
(deffunction seven () 7)
(deffunction slot-v () (printout t "evaluated" crlf) v)
(deffunction text () "x")
(deffunction one () 1)
(defrule run ?f <- (item) =>
  (printout t "missing:" (fact-slot-value 9 (seven)) crlf)
  (printout t "negative:" (fact-slot-value -1 (slot-v)) crlf)
  (printout t "wrong-type:" (fact-slot-value (text) (slot-v)) crlf)
  (printout t "predicates:" (fact-existp (text)) " " (fact-relation (text)) " " (fact-slot-names (text)) crlf)
  (printout t "index:" (fact-index (one)) crlf)
  (retract ?f)
  (printout t "stale:" (fact-slot-value ?f (slot-v)) crlf)
  (printout t "continued" crlf))
