(defglobal ?*queries* = 0)
(deffunction mark (?x) (bind ?*queries* (+ ?*queries* 1)) TRUE)
(defgeneric choose)
(defmethod choose ((?x NUMBER (mark ?x))) number)
(defmethod choose ((?x INTEGER))
  (printout t (call-next-method) ":" ?*queries* crlf)
  (printout t (call-next-method) ":" ?*queries* crlf)
  integer)
(defrule run => (printout t (choose 1) crlf))
