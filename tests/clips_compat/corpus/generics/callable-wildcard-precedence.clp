(defgeneric c4)
(defmethod c4 1 (($?xs INTEGER)) typed)
(defmethod c4 2 (?x $?xs) untyped)
(defgeneric p1)
(defmethod p1 ($?xs) wild)
(defmethod p1 (?x $?xs) fixed-wild)
(defgeneric p7)
(defmethod p7 (($?xs INTEGER)) typed-wild)
(defmethod p7 (?x ?y) two-fixed)
(defgeneric p8)
(defmethod p8 (($?xs INTEGER)) typed-wild)
(defmethod p8 (?x ?y $?z) two-fixed-wild)
(defgeneric p9)
(defmethod p9 ((?x INTEGER) ($?xs INTEGER)) a)
(defmethod p9 ((?x INTEGER) ?y $?z) b)
(defgeneric p10)
(defmethod p10 (($?xs (> 1 0))) query-wild)
(defmethod p10 (?x $?xs) fixed-wild)
(defgeneric e1)
(defmethod e1 (?x $?y) one-wild)
(defmethod e1 (?x) one)
(defgeneric e4)
(defmethod e4 ($?y) wild)
(defmethod e4 () none)
(defrule run =>
  (printout t "c4:" (c4 1) " " (c4 1 2) " " (c4 a) crlf)
  (printout t "p1:" (p1 1) " " (p1 1 2) crlf)
  (printout t "p7:" (p7 1 2) crlf)
  (printout t "p8:" (p8 1 2) " " (p8 1 2 3) crlf)
  (printout t "p9:" (p9 1 2) crlf)
  (printout t "p10:" (p10 1) crlf)
  (printout t "e1:" (e1 1) crlf)
  (printout t "e4:" (e4) crlf))
