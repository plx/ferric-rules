(defgeneric g)
(defmethod g (($?x INTEGER LEXEME)) 0)
(defmethod g (($?x NUMBER LEXEME)) 1)
(defmethod g ((?x INTEGER FLOAT SYMBOL) $?y) 2)
(defmethod g ($?x) 3)
(defmethod g (($?x INTEGER STRING)) 4)
(defmethod g (?x) 5)
(defmethod g ((?x NUMBER) $?y) 6)
(defmethod g (($?x INTEGER SYMBOL)) 7)
(defmethod g ((?x NUMBER)) 8)
(defmethod g ((?x NUMBER LEXEME) $?y) 9)
(defmethod g ((?x INTEGER SYMBOL) $?y) 10)
(defmethod g ((?x INTEGER STRING) $?y) 11)
(defmethod g ((?x NUMBER SYMBOL) $?y) 12)
(defmethod g (($?x INTEGER FLOAT SYMBOL)) 13)
(defmethod g ((?x INTEGER)) 14)
(defmethod g (($?x INTEGER)) 15)
(defmethod g ((?x INTEGER) $?y) 16)
(defmethod g (($?x NUMBER SYMBOL)) 17)
(defmethod g ((?x INTEGER LEXEME) $?y) 18)
(defmethod g (($?x NUMBER)) 19)
(defmethod g (?x $?y) 20)
(defrule run => (printout t (g 1) crlf))
