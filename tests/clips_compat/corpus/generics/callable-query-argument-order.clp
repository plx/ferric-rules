(defglobal ?*q* = 0)
(deffunction mark () (bind ?*q* (+ ?*q* 1)) TRUE)
(defgeneric m)
(defmethod m (?x ?y) fallback)
(defmethod m ((?x INTEGER (mark)) (?y INTEGER)) specific)
(defgeneric w)
(defmethod w (($?r (mark))) yes)
(defgeneric n)
(defmethod n (?x ?y) fallback)
(defmethod n ((?x INTEGER) (?y INTEGER (mark))) specific)
(defgeneric v)
(defmethod v ($?r) fallback)
(defmethod v (($?r INTEGER (mark))) yes)
(defrule run =>
  (printout t (m 1 abc) ":" ?*q* crlf)
  (printout t (w a b c) ":" ?*q* crlf)
  (printout t (w) ":" ?*q* crlf)
  (printout t (n abc 1) ":" ?*q* crlf)
  (printout t (v 1 2 abc 3) ":" ?*q* crlf))
