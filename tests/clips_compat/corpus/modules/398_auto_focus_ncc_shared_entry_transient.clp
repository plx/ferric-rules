(defmodule MAIN (export ?ALL))
(deftemplate MAIN::item)
(deftemplate MAIN::blocker)
(deftemplate MAIN::other)
(deftemplate MAIN::extra)
(defrule MAIN::older (item) (blocker) => (printout t older crlf))
(defrule MAIN::older2 (item) (extra) => (printout t older2 crlf))
(defmodule WATCH (import MAIN ?ALL))
(defrule WATCH::af (declare (auto-focus TRUE)) (item) (not (and (blocker) (other))) => (printout t af crlf))
(defrule WATCH::plain (item) => (printout t plain crlf))
(deffacts MAIN::init (blocker) (other))
(defrule MAIN::start (declare (salience 10)) => (assert (item)) (printout t "stack:" (get-focus-stack) crlf))
