(defmodule MAIN (export ?ALL))
(deftemplate MAIN::p)
(deftemplate MAIN::a)
(deftemplate MAIN::b)
(deftemplate MAIN::c)
(deftemplate MAIN::d)
(deffacts MAIN::init (c) (p))
(defmodule WATCH (import MAIN ?ALL))
(defrule WATCH::af (declare (auto-focus TRUE)) (p) (not (and (c) (not (and (a) (b))))) => (printout t af crlf))
(defrule WATCH::plain (p) => (printout t plain crlf))
(defrule MAIN::report => (printout t "stack:" (get-focus-stack) crlf))
