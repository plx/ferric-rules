(deffacts d (item) (b 1) (a 1) (num 1))
(defrule dormant (declare (auto-focus TRUE)) (never) => (printout t dormant crlf))
(defrule y (item) => (printout t y crlf))
(defrule b (item) (not (and (blocker) (other))) => (printout t b crlf))
(defrule x (declare (auto-focus TRUE)) (item) => (printout t x crlf))
(defrule r2 (a ?x) (test (> ?x -1)) => (printout t r2 crlf))
(defrule r1 (a ?x) (test (> ?x 0)) (b ?y) (test (> ?y 0)) => (printout t r1 crlf))
(defrule s2 (num ?x) (test (> ?x 0)) => (printout t s2 crlf))
(defrule s3 (num ?x) (test (> ?x 0)) (test (< ?x 5)) => (printout t s3 crlf))
