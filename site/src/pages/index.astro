---
import markUrl from "../assets/tool-mark.svg?url";
import { siteConfig } from "../site.config.mjs";
import "../styles/theme.css";
import "../styles/landing.css";

const siteBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path = "") => `${siteBase}${path.replace(/^\/+/, "")}`;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolveHref = (href: string) =>
  isExternal(href) || href.startsWith("#") ? href : sitePath(href);
const externalRel = (href: string) =>
  isExternal(href) ? "noopener noreferrer" : undefined;
const externalTarget = (href: string) =>
  isExternal(href) ? "_blank" : undefined;

const clipsExample = String.raw`(defrule flag-faulty-sensor
  (declare (salience 10))
  (sensor-error ?id)
  =>
  (assert (suppressed ?id)))

(defrule high-temp-alert
  (reading ?id ?temp)
  (test (> ?temp 75))
  (not (suppressed ?id))
  =>
  (assert (alert ?id high-temperature)))`;

const rustExample = String.raw`use ferric_rules::runtime::{Engine, RunLimit};

let mut engine = Engine::with_rules(
    include_str!("rules.clp"),
)?;
let kiln = engine.symbol_value("kiln-1")?;
engine.assert_ordered(
    "reading",
    vec![kiln, 82_i64.into()],
)?;

engine.run(RunLimit::Count(100))?;
assert_eq!(engine.find_facts("alert")?.len(), 1);`;
---

<!doctype html>
<html lang={siteConfig.site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteConfig.project.title} — {siteConfig.project.tagline}</title>
    <meta name="description" content={siteConfig.project.description} />
    <meta property="og:title" content={siteConfig.project.title} />
    <meta property="og:description" content={siteConfig.project.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.site.url} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap"
    />
  </head>
  <body class="landing-page">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="site-nav landing-nav" aria-label="Primary navigation">
        <a class="site-nav__brand landing-brand" href={sitePath()}>
          <img
            class="landing-brand__mark"
            src={markUrl}
            alt=""
            width="32"
            height="32"
          />
          <span>{siteConfig.project.title}</span>
        </a>
        <div class="site-nav__links">
          {
            siteConfig.landing.nav.map((link) => (
              <a
                class="site-nav__link"
                href={resolveHref(link.href)}
                target={externalTarget(link.href)}
                rel={externalRel(link.href)}
              >
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="site-nav__actions">
          <a
            class="btn btn--ghost btn--sm"
            href={siteConfig.repository.url}
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
        </div>
        <button
          class="site-nav__toggle"
          type="button"
          aria-label="Open navigation"
          aria-controls="mobile-nav"
          aria-expanded="false"
          data-nav-toggle
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
            ><path d="M4 7h16"></path><path d="M4 12h16"></path><path
              d="M4 17h16"></path></svg
          >
        </button>
      </nav>
      <div class="site-nav__drawer-scrim" data-nav-scrim data-open="false">
      </div>
      <div
        class="site-nav__panel"
        id="mobile-nav"
        data-nav-panel
        data-open="false"
      >
        {
          siteConfig.landing.nav.map((link) => (
            <a
              class="site-nav__panel-link"
              href={resolveHref(link.href)}
              target={externalTarget(link.href)}
              rel={externalRel(link.href)}
              data-nav-link
            >
              {link.label}
            </a>
          ))
        }
        <a
          class="site-nav__panel-link"
          href={siteConfig.repository.url}
          target="_blank"
          rel="noopener noreferrer"
          data-nav-link
        >
          GitHub
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero section-band" aria-labelledby="hero-title">
        <div class="section-shell hero__grid">
          <div class="hero__copy">
            <div class="hero__brand-line">
              <img
                class="hero__mark"
                src={markUrl}
                alt=""
                width="48"
                height="48"
              />
              <h1 id="hero-title">{siteConfig.project.title}</h1>
            </div>
            <p class="hero__subtitle">{siteConfig.project.tagline}</p>
            <p class="hero__body">
              <code>ferric-rules</code> is a forward-chaining Rete rules engine modeled
              on <a
                class="inline-link"
                href="https://www.clipsrules.net/"
                target="_blank"
                rel="noopener noreferrer">CLIPS 6.30</a
              >. It keeps the core CLIPS rule language—ordered and template
              facts, pattern matching, negated and existential conditions,
              salience, modules, and functions—while reimplementing the runtime
              in safe Rust with isolated per-engine state and a C ABI designed
              for embedding across FFI.
            </p>
            <p class="hero__body" id="status">
              <strong>Project status:</strong> This is a personal side project and
              an active prototype, not a battle-tested product. The core engine, CLI,
              C ABI, and host bindings work and are tested continuously against a
              CLIPS 6.30 reference binary, but no packages are published to registries
              yet, pre-1.0 APIs and snapshot formats still change as semantics are
              tightened, the COOL object system is out of scope, and
              <code>logical</code> truth maintenance is not yet implemented.
            </p>
            <div class="hero__actions">
              <a
                class="btn btn--primary btn--md"
                href={resolveHref(siteConfig.landing.primaryCta.href)}
              >
                {siteConfig.landing.primaryCta.label}
              </a>
              <a
                class="btn btn--ghost btn--md"
                href={resolveHref(siteConfig.landing.secondaryCta.href)}
                target={externalTarget(siteConfig.landing.secondaryCta.href)}
                rel={externalRel(siteConfig.landing.secondaryCta.href)}
              >
                {siteConfig.landing.secondaryCta.label}
              </a>
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <svg class="hero-visual__svg" viewBox="0 0 840 560" aria-hidden="true">
              <defs>
                <pattern
                  id="draft-grid"
                  width="32"
                  height="32"
                  patternUnits="userSpaceOnUse"
                >
                  <path
                    d="M32 0H0V32"
                    fill="none"
                    stroke="#0F1115"
                    stroke-opacity="0.08"
                    stroke-width="1"></path>
                </pattern>
                <marker
                  id="node-dot"
                  viewBox="0 0 10 10"
                  refX="5"
                  refY="5"
                  markerWidth="5"
                  markerHeight="5"
                >
                  <circle cx="5" cy="5" r="3" fill="#6B7280"></circle>
                </marker>
              </defs>
              <rect width="840" height="560" fill="url(#draft-grid)"></rect>
              <g class="protractor">
                <path d="M128 312a190 190 0 0 1 380 0"></path>
                <path d="M168 312a150 150 0 0 1 300 0"></path>
                <path d="M318 118v220"></path>
                <path d="M128 312h380"></path>
                <path d="M178 184l280 256"></path>
                <path d="M458 184 178 440"></path>
              </g>
              <g class="girder">
                <path d="M280 42 824 0"></path>
                <path d="M294 104 840 70"></path>
                <path d="M310 96 804 54"></path>
                <path d="M338 100 412 42 480 92 552 31 625 84 704 20 792 75"
                ></path>
                <path d="M328 52 410 101 478 44 552 92 624 35 704 88 781 25"
                ></path>
                <path d="M560 71v214"></path>
                <path d="M614 66v197"></path>
                <path d="M560 188h54"></path>
                <path d="M560 232h54"></path>
              </g>
              <g class="rete" marker-mid="url(#node-dot)">
                <path d="M122 378H230H336H444H552H660"></path>
                <path d="M122 438H230H336H444H552H660"></path>
                <path d="M122 498H230H336H444H552H660"></path>
                <path d="M230 378 336 438 444 378 552 498 660 438"></path>
                <path d="M230 498 336 438 444 498 552 378 660 438"></path>
              </g>
              <g class="rete-nodes">
                <circle cx="336" cy="438" r="10"></circle>
                <circle cx="444" cy="378" r="10"></circle>
                <circle cx="552" cy="498" r="10"></circle>
                <circle cx="660" cy="438" r="10"></circle>
              </g>
            </svg>
          </div>
        </div>
      </section>

      <section
        class="section-band section-band--top-border"
        id="scope"
        aria-labelledby="scope-title"
      >
        <div class="section-shell">
          <div class="section-heading">
            <h2 id="scope-title">Design focus &amp; scope</h2>
          </div>
          <div class="feature-grid">
            <article class="feature-card">
              <h3 class="feature-card__title">Embeddable over FFI</h3>
              <p class="feature-card__body">
                Classic CLIPS carries C global and environment ceremony that can
                be awkward to embed in modern host runtimes. In
                <code>ferric-rules</code>, every <code>Engine</code> owns all of its
                state (<code>Send + Sync</code> in Rust, with no global singletons).
                A panic-contained C ABI (<code>ferric.h</code>) backs bindings
                for Swift and Go alongside native napi-rs (TypeScript/Node) and
                PyO3 (Python) extensions, with optional CBOR snapshots for saving
                and resuming engine state.
              </p>
              <a class="text-link" href={sitePath("docs/embedding/")}
                >Embedding &amp; bindings</a
              >
            </article>
            <article class="feature-card">
              <h3 class="feature-card__title">Checked against CLIPS 6.30</h3>
              <p class="feature-card__body">
                The parser, Rete core, and runtime crates forbid
                <code>unsafe</code> code. Language behavior is checked against a pinned
                CLIPS 6.30 container across roughly 1,270 small corpus programs—including
                snapshot and restore round-trips—with known divergences pinned
                in the test suite or tracked in open issues. Unsupported CLIPS
                constructs fail with located load errors rather than silently
                doing something approximate.
              </p>
              <a class="text-link" href={sitePath("docs/compatibility/")}
                >Compatibility details</a
              >
            </article>
            <article class="feature-card">
              <h3 class="feature-card__title">Indexed Rete matching</h3>
              <p class="feature-card__body">
                Rules compile into an alpha/beta Rete network with hash-indexed
                joins across positive patterns, simple negations,
                <code>exists</code> conditions, and negated conjunctions, backed by
                <code>slotmap</code> arenas and inline small vectors. Criterion benchmarks
                and fourteen release-mode scaling checks help catch accidental complexity
                regressions—such as linear propagation turning quadratic—as semantics
                evolve.
              </p>
              <a class="text-link" href={sitePath("docs/architecture/")}
                >Architecture &amp; scaling</a
              >
            </article>
          </div>
        </div>
      </section>

      <section
        class="section-band section-band--muted"
        id="example"
        aria-labelledby="example-title"
      >
        <div class="section-shell syntax-grid">
          <div class="syntax-copy">
            <h2 id="example-title">Forward chaining in a few lines</h2>
            <p>
              A host application loads CLIPS rules once, asserts facts
              describing the current state, runs the agenda, and reads back
              derived facts or buffered output. Here, an active sensor fault
              suppresses alerts; otherwise, a reading above the threshold
              derives an <code>(alert ...)</code> fact.
            </p>
            <p>
              <code>Engine::with_rules</code> compiles the rule network and runs
              <code>(reset)</code>. Calling <code>engine.reset()</code> clears working
              memory so the compiled network can be reused for the next input.
            </p>
            <a class="text-link" href={sitePath("docs/getting-started/")}
              >Walk through a complete program</a
            >
          </div>
          <div class="code-compare">
            <div class="code-panel">
              <div class="code-panel__header">
                <span class="code-panel__dot" aria-hidden="true"></span>
                <span>rules.clp</span>
              </div>
              <pre
                class="code-panel__body"
                tabindex="0"><code set:text={clipsExample} /></pre>
            </div>
            <div class="code-panel">
              <div class="code-panel__header">
                <span class="code-panel__dot" aria-hidden="true"></span>
                <span>Rust host</span>
              </div>
              <pre
                class="code-panel__body"
                tabindex="0"><code set:text={rustExample} /></pre>
            </div>
          </div>
        </div>
      </section>

      <section class="section-band" id="docs" aria-labelledby="docs-title">
        <div class="section-shell">
          <div class="section-heading">
            <h2 id="docs-title">Documentation</h2>
          </div>
          <div class="doc-grid">
            {
              siteConfig.docs.pages.map((page) => (
                <a class="doc-card" href={sitePath(page.href)}>
                  <h3 class="doc-card__title">{page.title}</h3>
                  <p class="doc-card__body">{page.description}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="footer-rich">
      <div class="footer-rich__inner">
        <div class="footer-rich__brand-row">
          <img class="footer-mark" src={markUrl} alt="" width="32" height="32" />
          <span>{siteConfig.project.title}</span>
        </div>
        <div class="footer-rich__bottom">
          <span class="footer-rich__meta">Licensed under MIT or Apache-2.0.</span>
          <nav class="footer-rich__meta" aria-label="Footer navigation">
            {
              siteConfig.landing.footerLinks.map((link) => (
                <a class="footer-rich__link" href={resolveHref(link.href)}>
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </footer>

    <script>
      import "../scripts/landing.ts";
    </script>
  </body>
</html>
