---
import markUrl from "../assets/tool-mark.svg?url";
import { siteConfig } from "../site.config.mjs";
import "../styles/theme.css";
import "../styles/landing.css";

const siteBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path = "") => `${siteBase}${path.replace(/^\/+/, "")}`;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolveHref = (href: string) =>
  isExternal(href) || href.startsWith("#") ? href : sitePath(href);
const externalRel = (href: string) => (isExternal(href) ? "noopener noreferrer" : undefined);
const externalTarget = (href: string) => (isExternal(href) ? "_blank" : undefined);

const clipsExample = String.raw`(defrule high-temperature
  (temperature ?t)
  (test (> ?t 75))
  =>
  (printout t "High temperature" crlf))`;

const rustExample = String.raw`use ferric_rules::runtime::{Engine, RunLimit};

let mut engine = Engine::with_rules(
    include_str!("rules.clp"),
)?;
engine.assert_ordered("temperature", 80_i64)?;
engine.run(RunLimit::Count(100))?;

assert_eq!(
    engine.get_output("t"),
    Some("High temperature\n"),
);`;
---

<!doctype html>
<html lang={siteConfig.site.language}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{siteConfig.project.title} | {siteConfig.project.tagline}</title>
  <meta name="description" content={siteConfig.project.description}>
  <meta property="og:title" content={siteConfig.project.title}>
  <meta property="og:description" content={siteConfig.project.description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteConfig.site.url}>
  <meta name="twitter:card" content="summary">
  <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap"
  >
</head>
<body class="landing-page">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <nav class="site-nav landing-nav" aria-label="Primary navigation">
      <a class="site-nav__brand landing-brand" href={sitePath()}>
        <img class="landing-brand__mark" src={markUrl} alt="" width="32" height="32">
        <span>{siteConfig.project.title}</span>
      </a>
      <div class="site-nav__links">
        {siteConfig.landing.nav.map((link) => (
          <a
            class="site-nav__link"
            href={resolveHref(link.href)}
            target={externalTarget(link.href)}
            rel={externalRel(link.href)}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="site-nav__actions">
        <a class="btn btn--ghost btn--sm" href={siteConfig.repository.url} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a
          class="btn btn--primary btn--sm"
          href={resolveHref(siteConfig.landing.primaryCta.href)}
        >
          {siteConfig.landing.primaryCta.label}
        </a>
      </div>
      <button class="site-nav__toggle" type="button" aria-label="Open navigation" aria-controls="mobile-nav" aria-expanded="false" data-nav-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
    </nav>
    <div class="site-nav__drawer-scrim" data-nav-scrim data-open="false"></div>
    <div class="site-nav__panel" id="mobile-nav" data-nav-panel data-open="false">
      {siteConfig.landing.nav.map((link) => (
        <a
          class="site-nav__panel-link"
          href={resolveHref(link.href)}
          target={externalTarget(link.href)}
          rel={externalRel(link.href)}
          data-nav-link
        >
          {link.label}
        </a>
      ))}
      <a class="site-nav__panel-link" href={resolveHref(siteConfig.landing.primaryCta.href)} data-nav-link>
        {siteConfig.landing.primaryCta.label}
      </a>
    </div>
  </header>

  <main id="main">
    <section class="hero section-band" aria-labelledby="hero-title">
      <div class="section-shell hero__grid">
        <div class="hero__copy">
          <div class="section-index">.01 <span>Overview</span></div>
          <div class="hero__brand-line">
            <img class="hero__mark" src={markUrl} alt="" width="56" height="56">
            <h1 id="hero-title">{siteConfig.project.title}</h1>
          </div>
          <p class="hero__lede">{siteConfig.project.tagline}</p>
          <p class="hero__body">{siteConfig.project.description}</p>
          <p class="hero__body" id="status">A working prototype. Core functionality is implemented; validation, polish, and performance work continue. The COOL object system is out of scope. <code>logical</code> conditional elements (truth maintenance) are not supported and are rejected at load. <a class="text-link" href={sitePath('docs/compatibility/')}>Compatibility notes</a></p>
          <div class="hero__actions">
            <a class="btn btn--primary btn--lg" href={resolveHref(siteConfig.landing.primaryCta.href)}>
              {siteConfig.landing.primaryCta.label}
              <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
            </a>
            <a class="btn btn--ghost btn--lg" href={resolveHref(siteConfig.landing.secondaryCta.href)}>
              {siteConfig.landing.secondaryCta.label}
              <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
            </a>
          </div>
          <div class="install-command" aria-label="Install command">
            <code>$ {siteConfig.project.installCommand}</code>
            <button
              class="icon-btn"
              type="button"
              aria-label={`Copy command: ${siteConfig.project.installCommand}`}
              data-copy-text={siteConfig.project.installCommand}
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M4 16V6a2 2 0 0 1 2-2h10"/></svg>
            </button>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <svg class="hero-visual__svg" viewBox="0 0 840 560" aria-hidden="true">
            <defs>
              <pattern id="draft-grid" width="32" height="32" patternUnits="userSpaceOnUse">
                <path d="M32 0H0V32" fill="none" stroke="#0F1115" stroke-opacity="0.08" stroke-width="1"/>
              </pattern>
              <marker id="node-dot" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5">
                <circle cx="5" cy="5" r="3" fill="#6B7280"/>
              </marker>
            </defs>
            <rect width="840" height="560" fill="url(#draft-grid)"/>
            <g class="protractor">
              <path d="M128 312a190 190 0 0 1 380 0" />
              <path d="M168 312a150 150 0 0 1 300 0" />
              <path d="M318 118v220" />
              <path d="M128 312h380" />
              <path d="M178 184l280 256" />
              <path d="M458 184 178 440" />
            </g>
            <g class="girder">
              <path d="M280 42 824 0" />
              <path d="M294 104 840 70" />
              <path d="M310 96 804 54" />
              <path d="M338 100 412 42 480 92 552 31 625 84 704 20 792 75" />
              <path d="M328 52 410 101 478 44 552 92 624 35 704 88 781 25" />
              <path d="M560 71v214" />
              <path d="M614 66v197" />
              <path d="M560 188h54" />
              <path d="M560 232h54" />
            </g>
            <g class="rete" marker-mid="url(#node-dot)">
              <path d="M122 378H230H336H444H552H660" />
              <path d="M122 438H230H336H444H552H660" />
              <path d="M122 498H230H336H444H552H660" />
              <path d="M230 378 336 438 444 378 552 498 660 438" />
              <path d="M230 498 336 438 444 498 552 378 660 438" />
            </g>
            <g class="rete-nodes">
              <circle cx="336" cy="438" r="10"/>
              <circle cx="444" cy="378" r="10"/>
              <circle cx="552" cy="498" r="10"/>
              <circle cx="660" cy="438" r="10"/>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <section class="section-band section-band--muted" id="syntax" aria-labelledby="syntax-title">
      <div class="section-shell syntax-grid">
        <div class="syntax-copy">
          <div class="section-index">.02 <span>Example</span></div>
          <h2 id="syntax-title">One rule, one fact.</h2>
          <p>This rule matches a temperature above 75 and writes a message. The Rust host loads the rule, asserts a reading, and retrieves the output.</p>
          <p><code>with_rules</code> compiles the source and resets the engine. <code>run</code> fires matching rules, up to the given limit.</p>
          <a class="text-link" href={sitePath('docs/getting-started/')}>Run the complete example</a>
        </div>
        <div class="code-compare">
          <div class="code-panel">
            <div class="code-panel__header">
              <span class="code-panel__dot" aria-hidden="true"></span>
              <span>rules.clp</span>
            </div>
            <pre class="code-panel__body" tabindex="0"><code set:text={clipsExample}></code></pre>
          </div>
          <div class="code-panel">
            <div class="code-panel__header">
              <span class="code-panel__dot" aria-hidden="true"></span>
              <span>Rust host</span>
            </div>
            <pre class="code-panel__body" tabindex="0"><code set:text={rustExample}></code></pre>
          </div>
        </div>
      </div>
    </section>

    <section class="section-band" id="docs" aria-labelledby="docs-title">
      <div class="section-shell">
        <div class="section-heading">
          <div class="section-index">.03 <span>Documentation</span></div>
          <h2 id="docs-title">Documentation</h2>
        </div>
        <div class="doc-grid">
          {siteConfig.docs.pages.map((page) => (
            <a class="doc-card" href={sitePath(page.href)}>
              <h3 class="doc-card__title">{page.title}</h3>
              <p class="doc-card__body">{page.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <footer class="footer-rich">
    <div class="footer-rich__inner">
      <div class="footer-rich__brand-row">
        <img class="footer-mark" src={markUrl} alt="" width="32" height="32">
        <span>{siteConfig.project.title}</span>
      </div>
      <div class="footer-rich__bottom">
        <span class="footer-rich__meta">Licensed under MIT or Apache-2.0.</span>
        <nav class="footer-rich__meta" aria-label="Footer navigation">
          {siteConfig.landing.footerLinks.map((link) => (
            <a class="footer-rich__link" href={resolveHref(link.href)}>{link.label}</a>
          ))}
        </nav>
      </div>
    </div>
  </footer>

  <script>
    import "../scripts/landing.ts";
  </script>
</body>
</html>
