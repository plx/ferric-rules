;; Twenty-four candidates cross both scalar equality indexing thresholds.
(deftemplate item (slot group) (multislot tags) (slot proof (default ok)))
(defglobal ?*left* = 0 ?*right* = 0 ?*indexed-left* = 0 ?*indexed-right* = 0)
(deffacts input
  (key-before k0)
  (key-before k1)
  (key-before k2)
  (key-before k3)
  (key-before k4)
  (key-before k5)
  (key-before k6)
  (key-before k7)
  (key-before k8)
  (key-before k9)
  (key-before k10)
  (key-before k11)
  (key-before k12)
  (key-before k13)
  (key-before k14)
  (key-before k15)
  (key-before k16)
  (key-before k17)
  (key-before k18)
  (key-before k19)
  (key-before k20)
  (key-before k21)
  (key-before k22)
  (key-before k23)
  (item (group left) (tags payload k0 tail))
  (item (group left) (tags payload k1 tail))
  (item (group left) (tags payload k2 tail))
  (item (group left) (tags payload k3 tail))
  (item (group left) (tags payload k4 tail))
  (item (group left) (tags payload k5 tail))
  (item (group left) (tags payload k6 tail))
  (item (group left) (tags payload k7 tail))
  (item (group left) (tags payload k8 tail))
  (item (group left) (tags payload k9 tail))
  (item (group left) (tags payload k10 tail))
  (item (group left) (tags payload k11 tail))
  (item (group left) (tags payload k12 tail))
  (item (group left) (tags payload k13 tail))
  (item (group left) (tags payload k14 tail))
  (item (group left) (tags payload k15 tail))
  (item (group left) (tags payload k16 tail))
  (item (group left) (tags payload k17 tail))
  (item (group left) (tags payload k18 tail))
  (item (group left) (tags payload k19 tail))
  (item (group left) (tags payload k20 tail))
  (item (group left) (tags payload k21 tail))
  (item (group left) (tags payload k22 tail))
  (item (group left) (tags payload k23 tail))
  (item (group right) (tags payload k0 tail))
  (item (group right) (tags payload k1 tail))
  (item (group right) (tags payload k2 tail))
  (item (group right) (tags payload k3 tail))
  (item (group right) (tags payload k4 tail))
  (item (group right) (tags payload k5 tail))
  (item (group right) (tags payload k6 tail))
  (item (group right) (tags payload k7 tail))
  (item (group right) (tags payload k8 tail))
  (item (group right) (tags payload k9 tail))
  (item (group right) (tags payload k10 tail))
  (item (group right) (tags payload k11 tail))
  (item (group right) (tags payload k12 tail))
  (item (group right) (tags payload k13 tail))
  (item (group right) (tags payload k14 tail))
  (item (group right) (tags payload k15 tail))
  (item (group right) (tags payload k16 tail))
  (item (group right) (tags payload k17 tail))
  (item (group right) (tags payload k18 tail))
  (item (group right) (tags payload k19 tail))
  (item (group right) (tags payload k20 tail))
  (item (group right) (tags payload k21 tail))
  (item (group right) (tags payload k22 tail))
  (item (group right) (tags payload k23 tail))
  (key-after k0)
  (key-after k1)
  (key-after k2)
  (key-after k3)
  (key-after k4)
  (key-after k5)
  (key-after k6)
  (key-after k7)
  (key-after k8)
  (key-after k9)
  (key-after k10)
  (key-after k11)
  (key-after k12)
  (key-after k13)
  (key-after k14)
  (key-after k15)
  (key-after k16)
  (key-after k17)
  (key-after k18)
  (key-after k19)
  (key-after k20)
  (key-after k21)
  (key-after k22)
  (key-after k23)
)
(defrule right-arrival
  (key-before ?key) (item (tags $?prefix ?key tail) (proof ok) (group right))
  (test (= (length$ ?prefix) 1)) => (bind ?*right* (+ ?*right* 1)))
(defrule left-arrival
  (key-after ?key) (item (tags $?prefix ?key tail) (group left) (proof ok))
  (test (= (length$ ?prefix) 1)) => (bind ?*left* (+ ?*left* 1)))
(defrule indexed-left-arrival
  (item (tags $?prefix ?key tail) (group right) (proof ok)) (key-before ?key)
  (test (= (length$ ?prefix) 1)) => (bind ?*indexed-left* (+ ?*indexed-left* 1)))
(defrule indexed-right-arrival
  (item (tags $?prefix ?key tail) (proof ok) (group left)) (key-after ?key)
  (test (= (length$ ?prefix) 1)) => (bind ?*indexed-right* (+ ?*indexed-right* 1)))
(defrule summary (declare (salience -10))
  => (printout t ?*left* ":" ?*right* ":" ?*indexed-left* ":" ?*indexed-right* crlf))
