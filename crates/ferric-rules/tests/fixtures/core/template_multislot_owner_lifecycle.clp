(deftemplate item (slot key) (multislot tags))
(defglobal ?*count* = 0)
(deffacts input (item (key retained) (tags a marker b marker c)) (left a) (right b marker c) (phase one))
(defrule observe
  (item (tags $?a marker $?b) (key retained)) (phase ?phase)
  (not (and (left $?a) (right $?b)))
  => (bind ?*count* (+ ?*count* 1)))
(defrule remove-blocker (declare (salience -10))
  ?p <- (phase one) ?r <- (right $?)
  => (retract ?p ?r) (assert (phase two)))
(defrule replace-blocker (declare (salience -10))
  ?p <- (phase two)
  => (retract ?p) (assert (right b marker c) (phase three)))
(defrule remove-row (declare (salience -10))
  ?p <- (phase three) ?r <- (item (tags $?))
  => (retract ?p ?r) (assert (phase four)))
(defrule replace-row (declare (salience -10))
  ?p <- (phase four)
  => (retract ?p) (assert (item (key retained) (tags a marker b marker c)) (phase five)))
(defrule summary (declare (salience -20)) (phase five)
  => (printout t ?*count* crlf))
