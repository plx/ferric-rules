(deffunction scopes (?i ?x ?x-index)
  (bind ?i (+ ?i 1))
  (bind ?x (+ ?x 1))
  (bind ?x-index (+ ?x-index 1))
  (bind ?sum 0)
  (loop-for-count (?i 1 2) (bind ?sum (+ ?sum ?i)))
  (progn$ (?x (create$ 3 4)) (bind ?sum (+ ?sum ?x ?x-index)))
  (foreach ?x (create$ 5 6) (bind ?sum (+ ?sum ?x)))
  (create$ ?sum ?i ?x ?x-index))
(defrule probe => (printout t (scopes 90 80 70) crlf))
