
(defrule probe =>
 (printout t (integerp (max 9007199254740992.0 9007199254740993)) ":"
             (integerp (max 9007199254740993 9007199254740992.0)) crlf)
 (printout t (integerp (min 9007199254740992.0 9007199254740993)) ":"
             (integerp (min 9007199254740993 9007199254740992.0)) crlf)
 (printout t (eq (max 9007199254740993 9007199254740992.0) 9007199254740993) crlf)
 (printout t (eq (min 9007199254740993 9007199254740992.0) 9007199254740993) crlf))
