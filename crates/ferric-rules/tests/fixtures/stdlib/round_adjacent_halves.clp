(defrule probe =>
 (printout t (round 2.4999999999999996) ":" (round 2.5) ":" (round 2.5000000000000004) crlf)
 (printout t (round -2.5000000000000004) ":" (round -2.5) ":" (round -2.4999999999999996) crlf)
 (printout t (round 0.49999999999999994) ":" (round 0.5) ":" (round 0.5000000000000001) crlf)
 (printout t (round -0.5000000000000001) ":" (round -0.5) ":" (round -0.49999999999999994) crlf))
