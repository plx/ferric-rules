(defglobal ?*trace* = 0)
(deffunction mark (?digit ?value) (bind ?*trace* (+ (* ?*trace* 10) ?digit)) ?value)
(defrule probe =>
 (bind ?*trace* 0)
 (printout t "[" (sub-string (mark 1 0) (mark 2 0) (mark 3 "abc")) "]:" ?*trace* crlf)
 (bind ?*trace* 0)
 (printout t "[" (sub-string (mark 1 -2) (mark 2 -1) (mark 3 "abc")) "]:" ?*trace* crlf)
 (bind ?*trace* 0)
 (printout t "[" (sub-string (mark 1 3) (mark 2 2) (mark 3 "abc")) "]:" ?*trace* crlf)
 (bind ?*trace* 0)
 (printout t "[" (sub-string (mark 1 4) (mark 2 9) (mark 3 "abc")) "]:" ?*trace* crlf)
 (bind ?*trace* 0)
 (printout t "[" (sub-string (mark 1 4) (mark 2 4) (mark 3 "abc")) "]:" ?*trace* crlf)
 (bind ?*trace* 0)
 (printout t "[" (sub-string (mark 1 -9223372036854775808) (mark 2 9223372036854775807) (mark 3 "abc")) "]:" ?*trace* crlf)
 (bind ?*trace* 0)
 (printout t "[" (sub-string (mark 1 1) (mark 2 0) (mark 3 "abc")) "]:" ?*trace* crlf)
 (bind ?*trace* 0)
 (printout t "[" (sub-string (mark 1 0) (mark 2 2) (mark 3 "abc")) "]:" ?*trace* crlf)
)
