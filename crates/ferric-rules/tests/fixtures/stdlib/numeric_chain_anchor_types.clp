(defrule probe =>
  (printout t (= 2 2.0 2) ":" (<> 1 2 2) ":" (!= 1 2 2) ":" (<> 1 2 1) crlf)
  (printout t (= 9007199254740992.0 9007199254740993 9007199254740992) ":"
              (= 9007199254740993 9007199254740992.0 9007199254740992) crlf)
  (printout t (< 1 2 2) ":" (> 3 2 2) ":" (<= 1 2 2) ":" (>= 3 2 2) crlf))