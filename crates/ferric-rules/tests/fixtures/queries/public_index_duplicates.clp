;; Issue #329: user-visible fact assertion indices.
(deftemplate item (slot value))
(deffacts seed (item (value 10)))
(defrule probe =>
  (assert (item (value 10)))
  (assert (item (value 20)))
  (set-fact-duplication TRUE)
  (assert (item (value 10)))
  (set-fact-duplication FALSE)
  (assert (item (value 10)))
  (assert (item (value 30)))
  (do-for-fact ((?f item))
    (and (= (fact-slot-value ?f value) 10) (= (fact-index ?f) 1))
    (printout t "10:" (fact-index ?f) crlf))
  (do-for-fact ((?f item))
    (and (= (fact-slot-value ?f value) 10) (= (fact-index ?f) 3))
    (printout t "10:" (fact-index ?f) crlf))
  (do-for-fact ((?f item)) (= (fact-slot-value ?f value) 20)
    (printout t "20:" (fact-index ?f) crlf))
  (do-for-fact ((?f item)) (= (fact-slot-value ?f value) 30)
    (printout t "30:" (fact-index ?f) crlf)))
